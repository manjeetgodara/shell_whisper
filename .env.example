# Copy this file to .env (in this folder, or in ~/.how/.env) and fill in what you use.
# Variables already set in your shell take priority over this file.
# Never commit .env — it is in .gitignore.

# --- AI: DeepInfra (no extra package needed) ---
DEEPINFRA_API_KEY=

# --- AI: Claude (needs `pip install anthropic`) ---
# ANTHROPIC_API_KEY=

# --- Options ---
# HOW_PROVIDER=deepinfra        # deepinfra or claude, when both keys are set
# HOW_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# HOW_NO_AI=1                   # force offline mode
# HOW_HOME=                     # where learned.json / usage.json live (default ~/.how)
